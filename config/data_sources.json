      "providers": [
        {
          "id": "eu_taxud_cbam_benchmarks",
          "kind": "xlsx",
          "authority": "OFFICIAL",
          "legal_authority": false,
          "url": "https://taxation-customs.ec.europa.eu/document/download/9877523c-2a02-4926-a211-aefae7cf6d0d_en?filename=CBAM+Benchmarks_20260206.xlsx",
