      "authority_required": true,
      "refresh": "on_change",
      "providers": [
        {
          "id": "echa_scip_610",
          "kind": "landing_page",
          "authority": "OFFICIAL",
          "legal_authority": false,
          "url": "https://echa.europa.eu/en/scip-format",
