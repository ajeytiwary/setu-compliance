        {
          "id": "eu_taxud_taric",
          "kind": "landing_page",
          "authority": "OFFICIAL",
          "legal_authority": false,
          "url": "https://taxation-customs.ec.europa.eu/online-services/online-services-and-databases-customs/eu-customs-tariff-taric_en",
          "enabled": true
        },
        {
          "id": "taric_opendata_mirror",
          "kind": "github_release",
          "authority": "MIRROR",
          "legal_authority": false,
          "url": "https://github.com/rousseauxy/taric-opendata",
          "enabled": false
        }
      ]
    },
    "quota_balances": {
      "purpose": "EU first-come-first-served tariff quota balances",
      "authority_required": true,
      "refresh": "daily",
      "providers": [
        {
          "id": "eu_taxud_quota",
          "kind": "landing_page",
          "authority": "OFFICIAL",
          "legal_authority": false,
          "url": "https://taxation-customs.ec.europa.eu/online-services/online-services-and-databases-customs/tariff-quota-database-quota_en",
