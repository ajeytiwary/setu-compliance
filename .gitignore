.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
.vscode/
.workers/
workers/.wrangler/
data/*.db
*.tmp
.DS_Store
# Official reference snapshots (re-downloadable via scripts/sync_official_reference_data.py)
# Versioned upstream snapshots (re-downloadable via scripts/sync_sources.py --all).
# Raw payloads are machine materializations, not source truth (re-downloadable,
# hash-verified via manifests) -- hence ignored. Normalized latest.json snapshots
# + manifests ARE tracked so CI content gates validate real regulatory contents
# on checkout (see .github/workflows/ci.yml + tests/test_regulatory_content.py).
data/official/
data/sources/
data/cache/
data/raw/
data/client_data
data/demo_dossier
# Normalized + manifests: ignore everything EXCEPT the tracked CI snapshots
# (latest.json payloads + manifest pointers). Parent dirs must stay
# un-ignored for the negations below to take effect.
data/normalized/*
!data/normalized/*/
data/normalized/*/*
!data/normalized/*/latest.json
data/manifests/*
!data/manifests/*/
!data/manifests/*.json
data/manifests/*/*
!data/manifests/**/*.json
# Large generated demo snapshots: re-downloadable via sync scripts,
# not source truth. Keep out of git (4-15MB each).
data/normalized/industrial_telemetry_demo/
data/normalized/cbam_defaults/
data/manifests/industrial_telemetry_demo-latest.json
data/manifests/cbam_defaults-latest.json
# Benchmark run artifacts: local machine materializations (re-generable via
# pytest tests/benchmarks). Only the released bundles web/benchmarks/<sha>/
# are committed for the public /benchmarks page.
benchmark_artifacts/
# Local evidence blobs from smoke tests / walkthroughs (re-creatable).
data/evidence/
docs/Guidance document on CBAM implementation for installation operators outside the EU.pdf

# Reproducible public/client-like evidence corpus; regenerate with scripts/build_public_evidence_corpus.py
data/public_trade_evidence/
docs/dc39aec1969b4b04.pdf

# Public benchmark source downloads (retain URLs and hashes in gold.json)
data/public_corpus/downloads/
data/demo_dossier/bl_initial.pdf

# Generated Cloudflare Pages artifact.
dist/

# Local Cloudflare development state.
.wrangler/
