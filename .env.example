# JSW/Vijayanagar-style private production connection profile.
# EuroSetu does NOT ship real credentials or private endpoints.

# SAP SD OData
EUROSETU_SAP_SD_URL=https://<customer-sap-host>/sap/opu/odata/sap/<service>/<entityset>
EUROSETU_SAP_SD_USER=
EUROSETU_SAP_SD_PASSWORD=
EUROSETU_SAP_SD_FIELD_MAP={"shipment_id":"ShipmentId","sales_order":"SalesOrder","delivery_id":"DeliveryDocument","invoice_id":"BillingDocument","destination_country":"DestinationCountry","material_id":"Material","quantity_t":"QuantityTonnes","invoice_value_eur":"NetAmountEUR","currency":"TransactionCurrency","cn_code":"CommodityCode","customer_id":"SoldToParty","batch_id":"Batch"}

# SAP MM/PP OData
EUROSETU_SAP_MM_URL=https://<customer-sap-host>/sap/opu/odata/sap/<service>/<entityset>
EUROSETU_SAP_MM_USER=
EUROSETU_SAP_MM_PASSWORD=
EUROSETU_SAP_MM_FIELD_MAP={"material_document":"MaterialDocument","posting_date":"PostingDate","material_id":"Material","batch_id":"Batch","supplier_id":"Supplier","quantity":"Quantity","unit":"Unit","plant":"Plant","country_of_origin":"CountryOfOrigin","purchase_order":"PurchaseOrder"}

# MES REST endpoint returning an array or {"events": [...]}
EUROSETU_MES_URL=https://<customer-mes-host>/api/genealogy
EUROSETU_MES_BEARER_TOKEN=
EUROSETU_MES_FIELD_MAP={"event_time":"timestamp","plant":"plant","process":"process","parent_type":"parentType","parent_id":"parentId","child_type":"childType","child_id":"childId","quantity_t":"quantityTonnes","production_line":"line"}

# EMS/historian REST endpoint returning an array or {"measurements": [...]}
EUROSETU_EMS_URL=https://<customer-ems-host>/api/activity
EUROSETU_EMS_BEARER_TOKEN=
EUROSETU_EMS_FIELD_MAP={"timestamp":"timestamp","installation":"installation","production_process":"process","source_id":"meter","activity_type":"activity","quantity":"quantity","unit":"unit","measurement_method":"method","quality_flag":"quality"}

# Production identity (HS256 baseline; source the secret from a secret manager)
EUROSETU_OIDC_JWKS_URL=
EUROSETU_JWT_SECRET=
EUROSETU_JWT_ISSUER=
EUROSETU_JWT_AUDIENCE=

# PDF proposal assistant. Keep the key server-side; never put it in the browser.
EUROSETU_INGEST_LLM_BASE_URL=http://172.17.0.1:8787/api/v1
EUROSETU_INGEST_LLM_MODEL=deepseek/deepseek-v4-flash
EUROSETU_INGEST_LLM_API_KEY=
EUROSETU_INGEST_LLM_TIMEOUT_S=75

# Activate after app.eurosetu.trade and the Pages proxy are verified.
EUROSETU_SPLIT_HOSTS=0
EUROSETU_APP_HOST=app.eurosetu.trade
EUROSETU_PUBLIC_PROXY_SECRET=
